{
  "regions": ["cdg1"],
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/**",
      "excludeFiles": "backend/tests/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/calls-for-funds",
      "schedule": "0 8 1 * *"
    },
    {
      "path": "/api/cron/banking-sync",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

